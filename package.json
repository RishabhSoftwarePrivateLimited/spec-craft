{
  "name": "@rspl/speccraft",
  "version": "0.2.0",
  "description": "Scaffold a stage-gated spec-driven-development workflow (BRD → LLD → decompose → implement → test → validate) into a project, with guided greenfield/brownfield setup and Claude Code, Gemini CLI, and GitHub Copilot command support",
  "author": "Rishabh Software Private Limited",
  "bin": {
    "speccraft": "bin/speccraft.js"
  },
  "files": [
    "bin",
    "src",
    "templates"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build:examples": "node scripts/build-examples.js",
    "prepack": "node scripts/prepack.js",
    "postpack": "node scripts/postpack.js"
  },
  "keywords": [
    "sdd",
    "spec-driven-development",
    "spec-craft",
    "speccraft",
    "rspl",
    "@rspl",
    "claude-code",
    "gemini-cli",
    "copilot",
    "scaffold"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RishabhSoftwarePrivateLimited/spec-craft.git"
  },
  "homepage": "https://github.com/RishabhSoftwarePrivateLimited/spec-craft#readme",
  "bugs": "https://github.com/RishabhSoftwarePrivateLimited/spec-craft/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0"
  }
}
